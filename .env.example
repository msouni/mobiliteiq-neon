# Connexions DIRECTES Neon : désactiver Connection pooling dans Connect.
# Copier les URL complètes, sans guillemets et sans la commande psql.
DATABASE_URL=postgresql://UTILISATEUR:MOT_DE_PASSE@HOTE_NEON/mobiliteiq?sslmode=require
# Décommenter après création de la base démo :
# DATABASE_URL_DEMO=postgresql://UTILISATEUR:MOT_DE_PASSE@HOTE_NEON/mobiliteiq_demo?sslmode=require
# La base de test peut être créée dans un projet Neon distinct.
